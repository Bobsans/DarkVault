<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable><PublishAot>true</PublishAot><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- As in the server's NativeAot profile: dsymutil cannot resolve Clang module caches in runtime static libraries. -->
    <StripSymbols Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">false</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../clients/csharp/DarkVault.Client/DarkVault.Client.csproj" />
    <ProjectReference Include="../../clients/csharp/DarkVault.Extensions.Configuration/DarkVault.Extensions.Configuration.csproj" />
  </ItemGroup>
</Project>
