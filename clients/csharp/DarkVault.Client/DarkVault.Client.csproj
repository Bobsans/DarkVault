<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Token-authenticated DarkVault HTTP client with JWE encryption.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Bobsans/DarkVault</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="jose-jwt" Version="5.3.0" /><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="DarkVault.Client.Tests" /></ItemGroup>
</Project>
