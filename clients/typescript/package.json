{
  "name": "@darkvault/client",
  "version": "0.0.0-dev",
  "description": "Typed DarkVault HTTPS/JWE client",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bobsans/DarkVault.git",
    "directory": "clients/typescript"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
